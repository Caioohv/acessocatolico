# Acesso Católico — variáveis do docker-compose (modelo).
# Copie para `.env` na raiz:  cp .env.example .env  — e preencha as variáveis abaixo.

# 1. DATABASE_URL
# String de conexão do Prisma com o Postgres GLOBAL da VPS.
# Utilizada pelos serviços: migrate (aplica migrations), app (portal) e admin (painel).
#   - host   = global_psql       (container em infra/dbs/global_psql, rede caddy_net)
#   - user   = postgres          (senha = POSTGRES_ROOT_PASSWORD do global_psql)
#   - banco  = acessocatolico    (criado pelo init do global_psql — 01-databases.sql)
# Formato: postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public
DATABASE_URL=postgresql://postgres:SENHA_DO_POSTGRES_GLOBAL@global_psql:5432/acessocatolico?schema=public

# 2. NUXT_SESSION_PASSWORD
# Chave de criptografia de sessão usada pelo nuxt-auth-utils no serviço admin.
# Deve conter OBRIGATORIAMENTE no mínimo 32 caracteres.
# Gere uma chave aleatória segura com:
#   openssl rand -base64 32
#   ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# 3. NUXT_PUBLIC_SITE_URL (opcional)
# URL do portal público — destino do botão "Ir ao site" do painel admin.
# Se ausente, o admin usa o padrão https://acessocatolico.com.br.
NUXT_PUBLIC_SITE_URL=https://acessocatolico.com.br
