// Prisma schema — @acesso/db (fonte única do banco no monorepo).
//
// Fonte de verdade do modelo de dados compartilhada entre `portal/` e `admin/`.
// Fase 1: lojinha de afiliados (tabela `produtos`).
//
// Prisma 7: a `url` NÃO vive no bloco `datasource` — a conexão vem de
// prisma.config.ts (CLI) e do driver adapter no runtime (src/index.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  priceRef    String
  category    String
  affiliateUrl String
  imageUrl    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([category])
  @@index([active, category])
  @@map("produtos")
}
