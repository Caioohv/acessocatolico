// Prisma schema — @acesso/db (fonte única do banco no monorepo).
//
// Fonte de verdade do modelo de dados compartilhada entre `portal/` e `admin/`.
// Fase 1: lojinha de afiliados (tabela `produtos`).
//
// Prisma 7: a `url` NÃO vive no bloco `datasource` — a conexão vem de
// prisma.config.ts (CLI) e do driver adapter no runtime (src/index.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  priceRef    String
  category    String
  affiliateUrl String
  imageUrl    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([category])
  @@index([active, category])
  @@map("produtos")
}

// Auth do painel admin (Fase 2). v1: papel único `master` (o dono da plataforma).
// Depois passa a se ligar a Pessoa/Vínculo (RBAC por tenant) — ver definition.md.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("master")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// Métrica first-party do portal (pageview / clique em produto / leitura de artigo).
// `type`: "pageview" | "product_click" | "article_read".
// `targetId`: id do produto (product_click) ou slug do artigo (article_read); nulo em pageview.
// Índices compostos servem as agregações do painel: (type, createdAt) para séries temporais
// por tipo; (type, targetId) para ranking por alvo (produtos/artigos mais acessados).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String
  targetId  String?
  sessionId String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([type, targetId])
  @@map("analytics_events")
}
