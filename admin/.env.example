# Acesso Católico — painel admin — variáveis de ambiente (modelo)
# Copie este arquivo para `.env` e preencha com credenciais reais.
# NÃO commitar o `.env` (já ignorado no .gitignore).

# Conexão com o PostgreSQL (compartilhada com @acesso/db).
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://usuario:senha@localhost:5432/acessocatolico?schema=public"

# Chave de 32+ caracteres usada pelo nuxt-auth-utils para selar o cookie de sessão.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=""

# URL do portal público — destino do botão "Ir ao site" do painel.
# Opcional: se ausente, usa o padrão https://acessocatolico.com.br.
NUXT_PUBLIC_SITE_URL="https://acessocatolico.com.br"
